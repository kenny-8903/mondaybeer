# ─────────────────────────────────────────────────────────────
# 環境變數範本（複製成 .env 後填入真值；.env 已被 .gitignore 忽略）
# 注意：.env 的 FRONTEND_PORT / BACKEND_PORT / VITE_BACKEND_URL 一旦
#       在機器上設定好就不要改（見 AGENTS.md 的 port 規則）。
# ─────────────────────────────────────────────────────────────

# 本機服務埠（預設值；改之前先確認沒有跟其他軟體衝突）
FRONTEND_PORT=5173
BACKEND_PORT=8080
VITE_BACKEND_URL=http://localhost:8080

# Supabase（US-146 正式對接）
# Project Settings → API 取得；publishable / anon key 是給瀏覽器用的公開金鑰，
# 安全性由 RLS 決定。切勿把 service_role / secret key 放進前端或此檔。
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
